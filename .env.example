# Required
JWT_SECRET=change-me-to-a-random-32-plus-character-string

# Optional
CORS_ORIGIN=http://localhost
PORT=80

# open | first-user | closed — https://lyftr.app/configuration/#locking-down-registration
REGISTRATION=open

# Seeds demo@lyftr.local, whose password is public. Leave off on a reachable instance.
DEMO_MODE=false

# upstream | local. `upstream` queries open-exercise-db as you search and keeps a copy of
# the rows it has shown. `local` serves only the rows this instance already holds and makes
# no outbound request at all — for an instance that has finished importing and wants no
# third-party dependency in the request path.
#
# Local is not a way to START one: it cannot fill an empty catalog, and the backend warns
# on boot if you point it at one. To import everything first, run once on `upstream` and
# read an unfiltered page — that goes through oedb's bulk export:
#   curl -H "Authorization: Bearer $TOKEN" 'http://localhost/api/v1/exercises?limit=1000'
# then set EXERCISE_CATALOG=local and restart.
EXERCISE_CATALOG=upstream

# The open-exercise-db instance the exercise catalog is queried from. Lyftr does not
# ship or seed an exercise library: it asks this API as you search, and keeps only the
# rows it has shown. Unset uses the hosted instance; point it at your own to self-host
# the catalog too.
# OEDB_BASE_URL=https://oedb-api-o4dqddih5q-uk.a.run.app

# Address the frontend's nginx proxies /api to, over the internal Docker network.
# This MUST be the backend's Docker service name (backend) — NOT your host/LAN IP.
# Only change the port, and only if you set a custom backend PORT, e.g. backend:3008.
# A host IP like 192.168.1.10:3000 gives a 502 Bad Gateway: in the default compose
# the backend's port is only exposed on the Docker network, not published to the host.
BACKEND_ORIGIN=backend:3000
